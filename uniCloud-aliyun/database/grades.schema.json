{
  "BSONType": "object",
  "required": ["name", "section", "subject", "publisher"],
  "permission": {
    "read": true,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "name": {
      "bsonType": "string",
      "description": "年级名称，如 一年级、必修第一册"
    },
    "section": {
      "bsonType": "string",
      "description": "学段：小学/初中/高中/小学（五•四学制）/初中（五•四学制）"
    },
    "subject": {
      "bsonType": "string",
      "description": "科目名称"
    },
    "publisher": {
      "bsonType": "string",
      "description": "出版社全称"
    },
    "publisherShort": {
      "bsonType": "string",
      "description": "出版社简称"
    },
    "sort": {
      "bsonType": "int",
      "description": "排序值，数值越小越靠前"
    },
    "addTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
